// absolute import baseurl
{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./app/*"],
      "@/utils/*": ["./utils/*"],
      "@/components/*": ["./src/components/*"],
      "@/pages/*": ["./pages/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/*": ["./lib/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/api/*": ["./app/api/*"]
      // "@/public/*": ["./src/public/*"]
    }
  },
  "exclude": ["node_modules", "build", "public"]
}
